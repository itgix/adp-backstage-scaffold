{{- define "nexus.ingressClassName" -}}
{{- $infraServices := .infraServices -}}
{{- $cloud := default "aws" (index $infraServices "cloud") -}}
{{- $className := ternary "gce" "alb" (eq $cloud "gcp") -}}
{{- $className = default $className (index $infraServices "ingress_class_name") -}}
{{- $cloudClassKey := printf "%s_ingress_class_name" $cloud -}}
{{- default $className (index $infraServices $cloudClassKey) -}}
{{- end -}}
{{- define "nexus.ingressAnnotations" -}}
{{- $infraServices := .infraServices -}}
{{- $cloud := default "aws" (index $infraServices "cloud") -}}
{{- $ingressClassName := include "nexus.ingressClassName" (dict "infraServices" $infraServices) -}}
{{- $annotations := dict "external-dns.alpha.kubernetes.io/hostname" .host -}}
{{- if eq $cloud "gcp" -}}
{{- $_ := set $annotations "kubernetes.io/ingress.class" $ingressClassName -}}
{{- $managedCertificatesEnabled := true -}}
{{- if hasKey $infraServices "gcp_ingress_managed_certificates_enabled" -}}
{{- $managedCertificatesEnabled = index $infraServices "gcp_ingress_managed_certificates_enabled" -}}
{{- end -}}
{{- if $managedCertificatesEnabled -}}
{{- $_ := set $annotations "networking.gke.io/managed-certificates" "nexus" -}}
{{- end -}}
{{- $httpsRedirectEnabled := true -}}
{{- if hasKey $infraServices "gcp_ingress_https_redirect_enabled" -}}
{{- $httpsRedirectEnabled = index $infraServices "gcp_ingress_https_redirect_enabled" -}}
{{- end -}}
{{- if $httpsRedirectEnabled -}}
{{- $_ := set $annotations "networking.gke.io/v1beta1.FrontendConfig" "nexus" -}}
{{- end -}}
{{- else -}}
{{- $_ := set $annotations "alb.ingress.kubernetes.io/listen-ports" "[{\"HTTP\": 80}, {\"HTTPS\": 443}]" -}}
{{- $_ := set $annotations "alb.ingress.kubernetes.io/scheme" "internet-facing" -}}
{{- $_ := set $annotations "alb.ingress.kubernetes.io/ssl-redirect" "443" -}}
{{- $_ := set $annotations "alb.ingress.kubernetes.io/target-type" "ip" -}}
{{- $_ := set $annotations "alb.ingress.kubernetes.io/target-group-attributes" "stickiness.enabled=true,stickiness.lb_cookie.duration_seconds=86400" -}}
{{- $_ := set $annotations "alb.ingress.kubernetes.io/healthcheck-path" "/service/rest/v1/status" -}}
{{- end -}}
{{- $commonAnnotations := default dict (index $infraServices "ingress_annotations") -}}
{{- $cloudAnnotationsKey := printf "%s_ingress_annotations" $cloud -}}
{{- $cloudAnnotations := default dict (index $infraServices $cloudAnnotationsKey) -}}
{{- $annotations = mergeOverwrite $annotations $commonAnnotations $cloudAnnotations -}}
{{- toYaml $annotations -}}
{{- end -}}
{{- if ne (index .Values "infra-services" "app_nexus_enabled") false }}
{{- $infraServices := index .Values "infra-services" }}
{{- $cloud := default "aws" (index $infraServices "cloud") }}
{% if values.hostname -%}
{{- $nexusHost := "${{ values.hostname }}" }}
{%- else -%}
{{- $nexusHost := printf "%s-%s-nexus-%s.%s" (index $infraServices "project_name") (index $infraServices "region") (index $infraServices "environment") (index $infraServices "dns_main_domain") }}
{%- endif %}
apiVersion: argoproj.io/v1alpha1
kind: Application
metadata:
  name: nexus
  namespace: argocd
  annotations:
    argocd.argoproj.io/sync-wave: "4"
spec:
  destination:
    namespace: nexus
    server: https://kubernetes.default.svc
  project: 'applications'
  source:
    helm:
      releaseName: nexus
      valueFiles:
      - ../applications/values/${{ values.stage }}/${{ values.region }}/infra-facts.yaml
      - ../nexus/values.yaml
      - ../nexus/values/${{ values.stage }}/${{ values.region }}/values.yaml
      values: |
        nexus3:
          persistence:
            storageClass: {{ ternary "standard-rwo" "gp3" (eq $cloud "gcp") }}
          ingress:
            ingressClassName: {{ include "nexus.ingressClassName" (dict "infraServices" $infraServices) }}
            annotations:
{{- include "nexus.ingressAnnotations" (dict "infraServices" $infraServices "host" $nexusHost) | nindent 14 }}
            hosts:
              - {{ $nexusHost }}
    path: helm/nexus
    repoURL: {{ index .Values "infra-services" "applications_destination_repo" }}
    targetRevision: HEAD
  syncPolicy:
    automated:
      prune: true
      selfHeal: true
    syncOptions:
    - CreateNamespace=true
    - Replace=true
  revisionHistoryLimit: 3
{{- end }}
