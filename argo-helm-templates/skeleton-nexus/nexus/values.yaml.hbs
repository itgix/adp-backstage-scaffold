# Static platform defaults for Nexus Repository (AWS: ALB ingress, gp3 storage).
# Keys live under the upstream chart name `nexus3`. The ArgoCD Application only sets
# the ingress host. Sizing (storage size, resources, JVM heap) lives in
# values/<stage>/<region>/values.yaml.
nexus3:
  fullnameOverride: nexus
  # Keep the chown-data-dir init container ON (the chart default). The chart mounts
  # nexus.properties and logback files into /nexus-data/etc via subPath, so on a new
  # volume Kubernetes creates /nexus-data/etc as root and Nexus (uid 200) fails with
  # "AccessDeniedException: /nexus-data/etc/fabric". The init container (runs as root)
  # creates those dirs and chowns /nexus-data to 200.
  chownDataDir: true
  persistence:
    enabled: true
    accessMode: ReadWriteOnce
    storageClass: gp3
  ingress:
    enabled: true
    ingressClassName: alb
    annotations:
      alb.ingress.kubernetes.io/scheme: internet-facing
      alb.ingress.kubernetes.io/target-type: ip
      alb.ingress.kubernetes.io/listen-ports: '[{"HTTP": 80}, {"HTTPS": 443}]'
      alb.ingress.kubernetes.io/ssl-redirect: "443"
      alb.ingress.kubernetes.io/healthcheck-path: /service/rest/v1/status
      alb.ingress.kubernetes.io/target-group-attributes: stickiness.enabled=true,stickiness.lb_cookie.duration_seconds=86400
