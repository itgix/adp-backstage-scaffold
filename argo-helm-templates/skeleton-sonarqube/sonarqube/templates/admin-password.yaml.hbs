# SonarQube requires >= 12 characters with upper and lower case, a digit and a special character.
apiVersion: generators.external-secrets.io/v1alpha1
kind: Password
metadata:
  name: sonarqube-admin
  annotations:
    argocd.argoproj.io/sync-wave: "-2"
spec:
  length: 32
  digits: 6
  symbols: 4
  symbolCharacters: "-_.+=@%"
  noUpper: false
  allowRepeat: true
---
# Generated once. currentPassword is SonarQube's initial password, used by the change-admin-password hook.
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: sonarqube-admin
  annotations:
    argocd.argoproj.io/sync-wave: "-1"
spec:
  refreshInterval: "0"
  target:
    name: sonarqube-admin
    creationPolicy: Owner
    template:
      engineVersion: v2
      data:
        password: {{ "'{{ .password }}'" }}
        currentPassword: admin
  dataFrom:
    - sourceRef:
        generatorRef:
          apiVersion: generators.external-secrets.io/v1alpha1
          kind: Password
          name: sonarqube-admin
