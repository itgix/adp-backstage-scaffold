{{- if eq .Values.database.mode "external" }}
{{- $remoteKey := required "database.external.remoteKey is required" .Values.database.external.remoteKey }}
# The Secrets Manager value must be JSON with username and password.
apiVersion: external-secrets.io/v1beta1
kind: ExternalSecret
metadata:
  name: {{ .Values.database.external.credentialsSecretName }}
  annotations:
    argocd.argoproj.io/sync-wave: "-1"
spec:
  refreshInterval: 1h
  secretStoreRef:
    kind: ClusterSecretStore
    name: {{ .Values.database.external.secretStore }}
  target:
    name: {{ .Values.database.external.credentialsSecretName }}
    creationPolicy: Owner
  data:
    - secretKey: username
      remoteRef:
        key: {{ $remoteKey | quote }}
        property: username
    - secretKey: password
      remoteRef:
        key: {{ $remoteKey | quote }}
        property: password
{{- end }}
