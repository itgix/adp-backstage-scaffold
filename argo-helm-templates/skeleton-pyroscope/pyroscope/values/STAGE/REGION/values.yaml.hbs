# Per-environment configuration for Pyroscope on stage ${{ values.stage }}, region ${{ values.region }}.
# Values here override ../../../values.yaml.
#
# NESTING: the upstream chart is a dependency aliased as `pyroscope`, and its
# own values live under a top-level `pyroscope:` key. So every setting for the
# Pyroscope component sits at `pyroscope.pyroscope.*` (the outer key selects the
# subchart, the inner key is the chart's own `pyroscope` block).
#
# Configure object storage and the service-account identity for THIS environment
# below. Uncomment and fill in the block for your cloud. Each environment has its
# own bucket, identity and storage class.
pyroscope:
  pyroscope:
    replicaCount: 1

    persistence:
      size: 20Gi
      # Storage class for the PVC. AWS example: gp3. GCP example: standard-rwo.
      # storageClassName: gp3

    resources:
      limits:
        memory: 2Gi
      requests:
        cpu: 500m
        memory: 2Gi

